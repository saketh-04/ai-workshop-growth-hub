# Copy to .env at the repo root (never commit .env)
NODE_ENV=development
PORT=5000

# Any MongoDB works: local mongodb://127.0.0.1:27017/growth_hub  or an Atlas SRV URI
MONGODB_URI=

# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Demo admin. Set ADMIN_PASSWORD (hashed at boot) OR a precomputed ADMIN_PASSWORD_HASH (preferred in production).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

CLIENT_ORIGIN=http://localhost:5173

# Optional. Leave empty to run in deterministic fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only for `npm run test:integration` in /server - a THROWAWAY database (it gets dropped!)
MONGODB_URI_TEST=
